/ {
	clock_a: clock-a {
		compatible = "vnd,nxp-audio-clock";
		#clock-cells = <1>;
	};

	clock_b: clock-b {
		compatible = "vnd,nxp-audio-clock";
		#clock-cells = <1>;
	};

	clock_unready: clock-unready {
		compatible = "vnd,nxp-audio-clock";
		#clock-cells = <1>;
	};

	sai_clock_consumer: sai-clock-consumer {
		compatible = "vnd,nxp-sai-clock-consumer";
		clocks = <&clock_a 0x33>, <&clock_b 0x55>;
		clock-names = "bus", "mclk1";
	};
};
