 *
 * Capture from the PDM microphone instead of sending baked-in clips.
 * MICFIL here is interrupt-driven off its FIFO watermark, so capture needs no
 * DMA channel.
 */

/*
 * Retarget the existing node rather than deleting and re-creating it. The SoC
 * gates the whole audio clock tree on DT_NODELABEL(micfil) being enabled, and a
 * replacement node under a new label leaves that label undefined -- the PDM root
 * then stays at its 24 MHz default and MICFIL samples at the wrong rate while
 * everything still builds and runs.
 */
&micfil {
	compatible = "nxp,micfil";
	/delete-property/ dai-index;
	/delete-property/ dmas;
	/delete-property/ fifo-depth;
	/delete-property/ clock-names;

	#address-cells = <1>;
	#size-cells = <0>;
	interrupts = <109 0>;
	quality-mode = <1>;
	cic-decimation-rate = <0>;
	fifo-watermark = <4>;
	sample-rate = <16000>;
	pinctrl-0 = <&pdm_default>;
	pinctrl-names = "default";
	status = "okay";

	/*
	 * The driver builds its channel-enable mask by walking these children.
	 * A node without them enables no PDM channel and captures silence while
	 * still building cleanly.
	 */
	micfil-channel@0 { reg = <0>; };
	micfil-channel@1 { reg = <1>; };
};
