#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/ {
	/*
	 * The whole reserved window is 256 KiB at 0xa0000000. Every region below
	 * is a power-of-two size at a naturally aligned base, because the M7's
	 * ARMv7-M MPU can express nothing else: it rounds a size up to the next
	 * power of two and masks the base to match, so an odd region silently
	 * covers something other than what was asked for.
	 *
	 *   0xa0000000   4 KiB   bring-up control block
	 *   0xa0010000  64 KiB   IPC Service shared memory (control messages)
	 *   0xa0020000 128 KiB   audio buffer pool, readable by both cores
	 *
	 * The control block sits outside the region IPC Service owns. The
	 * static-vrings host clears its whole vdev status area on open, which
	 * would erase the retained session this design depends on.
	 */
	mpipe_ipc_ctrl: memory@a0000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0xa0000000 DT_SIZE_K(4)>;
		zephyr,memory-region = "MPIPE_IPC_CTRL";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	};

	mpipe_ipc_shm: memory@a0010000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0xa0010000 DT_SIZE_K(64)>;
		zephyr,memory-region = "MPIPE_IPC_SHM";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	};

	mpipe_shared_pool: memory@a0020000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0xa0020000 DT_SIZE_K(128)>;
		zephyr,memory-region = "MPIPE_SHARED_POOL";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	};

	ipc0: ipc0 {
		compatible = "zephyr,ipc-openamp-static-vrings";
		memory-region = <&mpipe_ipc_shm>;
		mboxes = <&mu3_a 0>, <&mu3_a 1>;
		mbox-names = "tx", "rx";
		role = "host";
		status = "okay";
	};
};

&mu3_a {
	status = "okay";
};

/*
 * Capture from the WM8960's analog input over SAI3, and play the same audio
 * back through the codec so it can be heard. Mirrors the wiring the audio
 * loopback sample uses on this board.
 */
/ {
	chosen {
		/*
		 * Buffers cross to the HiFi4 by address, so the pool must live
		 * where the HiFi4 can read it.
		 */
		zephyr,mpipe-aud-pool = &mpipe_shared_pool;
	};

	aliases {
		audio-codec-capture = &audio_codec;
		i2s-codec-rx = &sai3;
		i2s-codec-tx = &sai3;
	};
};

&sdma3 {
	status = "okay";
};

&sai3 {
	/delete-property/ dai-index;
	/delete-property/ mclk-is-output;
	compatible = "nxp,mcux-i2s";
	nxp,tx-channel = <1>;
	nxp,rx-sync-mode;
	mclk-output;
	pinctrl-0 = <&sai3_default>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c3 {
	status = "okay";
	pinctrl-0 = <&pinmux_i2c3>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	audio_codec: wm8960@1a {
		compatible = "wolfson,wm8960";
		reg = <0x1a>;
		clocks = <&ccm IMX_CCM_SAI3_CLK 0x0 0x0>;
		clock-names = "mclk";
		left-input = "WM8960_IN_MIC_DE_13";
		right-input = "WM8960_IN_MIC_DE_13";
		shared-lrclk;
	};
};
