/dts-v1/;

#include <nxp/imx/nxp_imx8ml_m7.dtsi>
#include "imx8mp_evk-pinctrl.dtsi"

/ {
	model = "NXP i.MX8M Plus EVK board";
	compatible = "nxp,mimx8mp_evk";

	chosen {
		/* DDR */
		zephyr,flash = &ddr_code;
		zephyr,sram = &ddr_sys;

		zephyr,console = &uart4;
		zephyr,shell-uart = &uart4;
	};
};

&uart4 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart4_default>;
	pinctrl-names = "default";
};

&gpio3 {
	status = "okay";
};

&mailbox0 {
	status = "okay";
};

/*
 * ENET1 (FEC) is wired to the RGMII PHY through the SAI1 pads. Its pads are
 * also the ones gpio4 muxes, so do not enable gpio4 together with ENET here.
 * The Cortex-A core must leave the controller alone: disable the matching
 * node in the Linux device tree before booting this image.
 */
&enet {
	status = "okay";
	pinctrl-0 = <&pinmux_enet>;
	pinctrl-names = "default";
};

&enet_mac {
	phy-handle = <&phy>;
	zephyr,random-mac-address;
	phy-connection-type = "rgmii";
	status = "okay";
};

&enet_mdio {
	pinctrl-0 = <&pinmux_mdio>;
	pinctrl-names = "default";
	status = "okay";

	phy: phy@1 {
		compatible = "realtek,rtl8211f";
		reg = <1>;
		status = "okay";
	};
};
