config SOC_MIMX8MM6_A53
	select ARM64
	select CPU_CORTEX_A53
	select ARM_ARCH_TIMER if SYS_CLOCK_EXISTS
	select HAS_MCUX if CLOCK_CONTROL
	select HAS_MCUX_RDC
	select HAS_MCUX_CACHE
	select SOC_PREP_HOOK

config SOC_MIMX8MM6_M4
	select ARM
	select CPU_CORTEX_M4
	select CPU_HAS_FPU
	select CPU_HAS_ARM_MPU
	select HAS_MCUX
	select HAS_MCUX_RDC
	select SOC_EARLY_INIT_HOOK

config SOC_MIMX8ML8_A53
	select ARM64
	select CPU_CORTEX_A53
	select ARM_ARCH_TIMER if SYS_CLOCK_EXISTS
	select HAS_MCUX if CLOCK_CONTROL
	select HAS_MCUX_RDC
	select HAS_MCUX_CACHE
	select SOC_PREP_HOOK

config SOC_MIMX8MN6_A53
	select ARM64
	select CPU_CORTEX_A53
	select ARM_ARCH_TIMER if SYS_CLOCK_EXISTS
	select HAS_MCUX if CLOCK_CONTROL
	select HAS_MCUX_RDC
	select HAS_MCUX_CACHE
	select SOC_PREP_HOOK

config SOC_MIMX8ML8_ADSP
	select XTENSA
	select XTENSA_HAL if ("$(ZEPHYR_TOOLCHAIN_VARIANT)" != "xcc" && "$(ZEPHYR_TOOLCHAIN_VARIANT)" != "xt-clang")
	select XTENSA_RESET_VECTOR
	select XTENSA_USE_CORE_CRT1
	select ATOMIC_OPERATIONS_BUILTIN
	select GEN_ISR_TABLES
	select XTENSA_SMALL_VECTOR_TABLE_ENTRY
	select HAS_MCUX if CLOCK_CONTROL
	select PINCTRL_IMX if PINCTRL
	select CPU_HAS_DCACHE

config SOC_MIMX8ML8_M7
	select ARM
	select CPU_CORTEX_M7
	select CPU_HAS_FPU
	select CPU_HAS_ICACHE
	select CPU_HAS_DCACHE
	select INIT_VIDEO_PLL
	select HAS_MCUX
	select HAS_MCUX_RDC
	select CPU_HAS_ARM_MPU
	select CPU_HAS_CUSTOM_FIXED_SOC_MPU_REGIONS
	select ARM_MPU
	select SOC_EARLY_INIT_HOOK

config SOC_MIMX8MQ6_M4
	select ARM
	select CPU_CORTEX_M4
	select CPU_HAS_FPU
	select CPU_HAS_ARM_MPU
	select HAS_MCUX
	select HAS_MCUX_RDC

config MCUX_CORE_SUFFIX
	default "_ca53" if SOC_MIMX8MM6_A53 || SOC_MIMX8MN6_A53 || SOC_MIMX8ML8_A53
	default "_dsp" if SOC_MIMX8ML8_ADSP
	default "_cm4" if SOC_MIMX8MM6_M4
	default "_cm7" if SOC_MIMX8ML8_M7
	default "_cm4" if SOC_MIMX8MQ6_M4

if SOC_MIMX8ML8_M7

choice CODE_LOCATION
	prompt "Code location selection"

config CODE_ITCM
	bool "Link code into internal instruction tightly coupled memory (ITCM)"

config CODE_DDR
	bool "Link code into DDR memory"

endchoice

config INIT_VIDEO_PLL
	bool "Initialize Video PLL"

config IMX8M_M7_AUDIOMIX_BOOT_HANDOFF
	bool "Boot firmware powers and hands off AUDIOMIX"
	help
	  Enable this only when boot firmware powers the AUDIOMIX domain and
	  hands control of its clocks and peripherals to the M7. This is a boot
	  prerequisite for using SAI3, SDMA3, or MICFIL from Zephyr.

config IMX8M_M7_AUDIO_PLL1
	bool "Let the M7 own Audio PLL1 and audio roots"
	depends on IMX8M_M7_AUDIOMIX_BOOT_HANDOFF
	default y
	help
	  Allow Zephyr to reprogram the shared Audio PLL1 and the enabled audio
	  roots for the 48 kHz sample-rate family. Leave this disabled when boot
	  firmware or another core owns those clocks; the AUDIOMIX clock
	  attachments are still made so the M7 sees the roots it was handed.

endif # SOC_MIMX8ML8_M7
